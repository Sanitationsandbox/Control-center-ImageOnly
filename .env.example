# Required on Vercel so every serverless instance reads the same control state.
# The Vercel Upstash integration adds these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative names supported by the app if using Vercel KV-style env vars.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for admin media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
